# Supabase
SUPABASE_URL=https://vtocnpgguwggpgvvylzn.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SERVICE_ROLE_KEY=your_service_role_key

# Resend (transactional email)
RESEND_API_KEY=your_resend_api_key_here

# Firebase / FCM (send-push Edge Function only — never in the app bundle)
# Paste the whole service-account JSON as one line:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Shared secret sent by the Supabase database webhook:
WEBHOOK_SECRET=your_random_webhook_secret